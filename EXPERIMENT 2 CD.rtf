\pard\sa200\sl276\slmult1 EXPERIMENT 2: Generate Three Address Code (TAC)\par
AIM:\par
\b0 To write a simple C program to generate Three Address Code (TAC) for an arithmetic expression such as a = b + c * d\par
\b ALGORITHM:\par

\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li720\sa200\sl276\slmult1\b0 Start\par
{\pntext\f1\'B7\tab}Read the given expression.\par
{\pntext\f1\'B7\tab}Scan the expression and identify the operators and operands.\par
{\pntext\f1\'B7\tab}Follow the operator precedence to evaluate the expression.\par
{\pntext\f1\'B7\tab}For each operation, create a temporary variable such as t1, t2, etc.\par
{\pntext\f1\'B7\tab}Generate a three-address instruction in the form: t1 = operand1 operator operand2\par
{\pntext\f1\'B7\tab}Replace the evaluated expression with its temporary variable.\par
{\pntext\f1\'B7\tab}Continue this process until the complete expression is evaluated.\par
{\pntext\f1\'B7\tab}Display the generated Three Address Code.\par
{\pntext\f1\'B7\tab}Stop.\par

\pard\sa200\sl276\slmult1\b INPUT\par
\b0 #include <stdio.h>\par
#include <stdlib.h>\par
#include <ctype.h>\par
#include <string.h>\par
\par
#define MAX 100\par
\par
// Stack structures for operators and operands\par
char opStack[MAX];\par
int opTop = -1;\par
\par
char *valStack[MAX];\par
int valTop = -1;\par
\par
int tempCount = 1;\par
\par
// Push operator\par
void pushOp(char ch)\par
\{\par
    if (opTop < MAX - 1)\par
    \{\par
        opStack[++opTop] = ch;\par
    \}\par
\}\par
\par
// Pop operator\par
char popOp()\par
\{\par
    if (opTop >= 0)\par
    \{\par
        return opStack[opTop--];\par
    \}\par
\par
    return '\\0';\par
\}\par
\par
// Peek operator\par
char peekOp()\par
\{\par
    if (opTop >= 0)\par
    \{\par
        return opStack[opTop];\par
    \}\par
\par
    return '\\0';\par
\}\par
\par
// Push operand\par
void pushVal(char *val)\par
\{\par
    if (valTop < MAX - 1)\par
    \{\par
        valStack[++valTop] = strdup(val);\par
    \}\par
\}\par
\par
// Pop operand\par
char *popVal()\par
\{\par
    if (valTop >= 0)\par
    \{\par
        return valStack[valTop--];\par
    \}\par
\par
    return NULL;\par
\}\par
\par
// Define operator precedence\par
int precedence(char op)\par
\{\par
    if (op == '+' || op == '-')\par
        return 1;\par
\par
    if (op == '*' || op == '/')\par
        return 2;\par
\par
    return 0;\par
\}\par
\par
// Generate TAC instruction\par
void processOperator()\par
\{\par
    char op = popOp();\par
\par
    char *right = popVal();\par
    char *left = popVal();\par
\par
    char *temp = (char *)malloc(10 * sizeof(char));\par
\par
    sprintf(temp, "t%d", tempCount++);\par
\par
    printf("%s = %s %c %s\\n", temp, left, op, right);\par
\par
    pushVal(temp);\par
\par
    free(left);\par
    free(right);\par
\}\par
\par
// Generate Three Address Code\par
void generateTAC(char *expr)\par
\{\par
    int i = 0;\par
\par
    // Separate target variable from RHS expression\par
    char target[MAX] = "";\par
    int targetIdx = 0;\par
\par
    while (expr[i] != '=' && expr[i] != '\\0')\par
    \{\par
        if (!isspace(expr[i]))\par
        \{\par
            target[targetIdx++] = expr[i];\par
        \}\par
\par
        i++;\par
    \}\par
\par
    target[targetIdx] = '\\0';\par
\par
    if (expr[i] == '=')\par
    \{\par
        i++;\par
    \}\par
    else\par
    \{\par
        // If there is no '='\par
        i = 0;\par
        target[0] = '\\0';\par
    \}\par
\par
    printf("\\nThree Address Code (TAC):\\n");\par
    printf("-------------------------\\n");\par
\par
    // Process the RHS expression\par
    while (expr[i] != '\\0')\par
    \{\par
        if (isspace(expr[i]))\par
        \{\par
            i++;\par
            continue;\par
        \}\par
\par
        // Parse variable or constant\par
        if (isalnum(expr[i]))\par
        \{\par
            char operand[MAX];\par
            int k = 0;\par
\par
            while (isalnum(expr[i]))\par
            \{\par
                operand[k++] = expr[i++];\par
            \}\par
\par
            operand[k] = '\\0';\par
\par
            pushVal(operand);\par
        \}\par
\par
        // Opening parenthesis\par
        else if (expr[i] == '(')\par
        \{\par
            pushOp(expr[i]);\par
            i++;\par
        \}\par
\par
        // Closing parenthesis\par
        else if (expr[i] == ')')\par
        \{\par
            while (opTop >= 0 && peekOp() != '(')\par
            \{\par
                processOperator();\par
            \}\par
\par
            popOp();\par
            i++;\par
        \}\par
\par
        // Operator\par
        else if (expr[i] == '+' ||\par
                 expr[i] == '-' ||\par
                 expr[i] == '*' ||\par
                 expr[i] == '/')\par
        \{\par
            while (opTop >= 0 &&\par
                   precedence(peekOp()) >= precedence(expr[i]))\par
            \{\par
                processOperator();\par
            \}\par
\par
            pushOp(expr[i]);\par
            i++;\par
        \}\par
\par
        else\par
        \{\par
            i++;\par
        \}\par
    \}\par
\par
    // Process remaining operators\par
    while (opTop >= 0)\par
    \{\par
        processOperator();\par
    \}\par
\par
    // Assign final result to target variable\par
    char *finalRes = popVal();\par
\par
    if (target[0] != '\\0' && finalRes != NULL)\par
    \{\par
        printf("%s = %s\\n", target, finalRes);\par
    \}\par
\par
    if (finalRes != NULL)\par
    \{\par
        free(finalRes);\par
    \}\par
\}\par
\par
int main()\par
\{\par
    char expr[MAX] = "a = b * c + d";\par
\par
    printf("Input Expression: %s\\n", expr);\par
\par
    generateTAC(expr);\par
\par
    return 0;\par
\b\}\par
