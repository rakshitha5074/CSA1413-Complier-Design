\b\fs36                       CSA1413 COMPILER DESIGN\par

\pard\sa200\sl276\slmult1\qc EXPERIMENT 4 - ELIMINATE DEAD CODE\par

\pard\sa200\sl276\slmult1\fs24 AIM\par
\b0 To write a C program to identify and eliminate dead code from a given sequence of\par
Three Address Code statements.\par
\b\par
ALGORITHM\par
\b0 1. Start the program.\par
2. Declare arrays to store TAC statements, left-hand-side variables, right-hand-side expressions, and live status.\par
3. Read TAC statements from the user until END is entered.\par
4. Separate each statement into its left-hand-side (LHS) and right-hand-side (RHS) using =.\par
5. Traverse the statements in reverse order, from the last statement to the first.\par
6. If a statement has no LHS, mark it as live.\par
7. Check whether the variable assigned by the statement is used by any later live statement.\par
8. If it is used, mark the statement as live.\par
9. Preserve statements that assign values to the output variables x or y.\par
10. For each live statement, identify the variables used in its RHS and mark their earlier definitions as live.\par
11. Repeat until all statements have been checked.\par
12. Display only the live statements as the Optimized Three Address Code.\par
13. Stop the program.\par
\par
\b CODE\par
\b0\fs22 #include <stdio.h>\par
#include <string.h>\par
#include <ctype.h>\par
#define MAX 100\par
#define LEN 100\par
int main()\par
\{\par
char code[MAX][LEN];\par
char lhs[MAX][LEN];\par
char rhs[MAX][LEN];\par
int live[MAX] = \{0\};\par
int n = 0, i, j;\par
char line[LEN];\par
printf("Enter Three Address Code statements.\\n");\par
printf("Enter END to finish:\\n");\par
while (n < MAX && fgets(line, sizeof(line), stdin))\par
\{\par
line[strcspn(line, "\\n")] = '\\0';\par
if (strcmp(line, "END") == 0)\par
break; if (strlen(line) == 0)\par
continue;\par
strcpy(code[n], line);\par
char *equal = strchr(line, '=');\par
if (equal != NULL)\par
\{\par
*equal = '\\0';\par
sscanf(line, "%99s", lhs[n]);\par
strcpy(rhs[n], equal + 1);\par
\}\par
else\par
\{\par
lhs[n][0] = '\\0';\par
rhs[n][0] = '\\0';\par
\}\par
n++;\par
\}\par
/*\par
Variables assigned to final program outputs\par
are considered live.\par
*/\par
for (i = n - 1; i >= 0; i--)\par
\{ if (lhs[i][0] == '\\0')\par
\{\par
live[i] = 1;\par
continue;\par
\}\par
int needed = 0;\par
for (j = i + 1; j < n; j++)\par
\{\par
if (live[j] && strcmp(lhs[i], lhs[j]) == 0)\par
\{\par
needed = 1;\par
break;\par
\}\par
\}\par
/*\par
Keep a statement if its result is used\par
by a live statement.\par
*/\par
if (needed)\par
\{\par
live[i] = 1;\par
\}\par
/*\par
Statements with externally visible\par
destinations are preserved. */\par
if (strcmp(lhs[i], "x") == 0 ||\par
strcmp(lhs[i], "y") == 0)\par
\{\par
live[i] = 1;\par
\}\par
/*\par
Mark earlier definitions of variables\par
used by this live statement.\par
*/\par
if (live[i])\par
\{\par
char *p = rhs[i];\par
while (*p)\par
\{\par
if (isalpha((unsigned char)*p) || *p == '_')\par
\{\par
char var[LEN];\par
int k = 0;\par
while (isalnum((unsigned char)*p) ||\par
*p == '_')\par
\{\par
var[k++] = *p++;\par
\}\par
var[k] = '\\0'; for (j = i - 1; j >= 0; j--)\par
\{\par
if (strcmp(lhs[j], var) == 0)\par
\{\par
live[j] = 1;\par
break;\par
\}\par
\}\par
\}\par
else\par
\{\par
p++;\par
\}\par
\}\par
\}\par
\}\par
printf("\\nOptimized Three Address Code:\\n");\par
for (i = 0; i < n; i++)\par
\{\par
if (live[i])\par
printf("%s\\n", code[i]);\par
\}\par
return 0;\par
\}\par
\par
