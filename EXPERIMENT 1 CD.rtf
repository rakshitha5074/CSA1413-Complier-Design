\pard\sa200\sl276\slmult1\fs24 EXPERIMENT 1: Lexical Analyzer Program in C \par
AIM:\par
\b0 To write a C program and identifies the basic tokens such as keywords, identifiers, operators, constants, and special symbols. \par

\pard\sa200\sl240\slmult1\b ALGORITHM\par

\pard{\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\fi-360\li720\sa200\sl240\slmult1\b0 Start\par
{\pntext\f1\'B7\tab}Read the input C program character by character.\par
{\pntext\f1\'B7\tab}If the character is a space or newline, skip it.\par
{\pntext\f1\'B7\tab}If the character is an alphabet or underscore, read the complete word.\par
{\pntext\f1\'B7\tab}If the word is a keyword, identify it as a keyword.\par
{\pntext\f1\'B7\tab}Otherwise, identify it as an identifier.\par
{\pntext\f1\'B7\tab}If the character is a digit, read the complete number and identify it as a number.\par
{\pntext\f1\'B7\tab}If the character is an operator such as +, -, *, /, =, <, >, identify it as an operator.\par
{\pntext\f1\'B7\tab}If the character is a special symbol such as (, ), \{, \}, ;, ,, identify it as a special symbol.\par
{\pntext\f1\'B7\tab}Continue until the end of the input is reached.\par
{\pntext\f1\'B7\tab}Display all identified tokens.\par
{\pntext\f1\'B7\tab}Stop.\par

\pard\sa200\sl276\slmult1\b INPUT\par
\b0 #include <stdio.h>\par
#include <string.h>\par
#include <ctype.h>\par
int isKeyword(char str[])\par
\{\par
char keywords[][20] = \{\par
"auto", "break", "case", "char", "const",\par
"continue", "default", "do", "double",\par
"else", "enum", "extern", "float", "for",\par
"goto", "if", "int", "long", "register",\par
"return", "short", "signed", "sizeof",\par
"static", "struct", "switch", "typedef",\par
"union", "unsigned", "void", "volatile",\par
"while"\par
\};\par
int i;\par
for (i = 0; i < 32; i++)\par
\{\par
if (strcmp(str, keywords[i]) == 0)\par
return 1;\par
\}\par
return 0;\par
\} int main()\par
\{\par
char input[1000];\par
int i = 0;\par
printf("Enter a C statement:\\n");\par
fgets(input, sizeof(input), stdin);\par
while (input[i] != '\\0')\par
\{\par
/* Ignore white spaces */\par
if (isspace(input[i]))\par
\{\par
i++;\par
continue;\par
\}\par
/* Identifier or Keyword */\par
if (isalpha(input[i]) || input[i] == '_')\par
\{\par
char word[50];\par
int j = 0;\par
while (isalnum(input[i]) || input[i] == '_')\par
\{\par
word[j++] = input[i++];\par
\}\par
word[j] = '\\0'; if (isKeyword(word))\par
printf("%s\\t\\tKeyword\\n", word);\par
else\par
printf("%s\\t\\tIdentifier\\n", word);\par
\}\par
/* Number */\par
else if (isdigit(input[i]))\par
\{\par
char number[50];\par
int j = 0;\par
while (isdigit(input[i]) || input[i] == '.')\par
\{\par
number[j++] = input[i++];\par
\}\par
number[j] = '\\0';\par
printf("%s\\t\\tConstant\\n", number);\par
\}\par
/* Arithmetic Operators */\par
else if (input[i] == '+' || input[i] == '-' ||\par
input[i] == '*' || input[i] == '/' ||\par
input[i] == '%')\par
\{\par
printf("%c\\t\\tArithmetic Operator\\n", input[i]);\par
i++;\par
\} /* Relational / Assignment Operators */\par
else if (input[i] == '=' || input[i] == '<' ||\par
input[i] == '>')\par
\{\par
if (input[i + 1] == '=')\par
\{\par
printf("%c%c\\t\\tRelational Operator\\n",\par
input[i], input[i + 1]);\par
i += 2;\par
\}\par
else\par
\{\par
printf("%c\\t\\tOperator\\n", input[i]);\par
i++;\par
\}\par
\}\par
/* Special Symbols */\par
else if (input[i] == '(' || input[i] == ')' ||\par
input[i] == '\{' || input[i] == '\}' ||\par
input[i] == '[' || input[i] == ']' ||\par
input[i] == ';' || input[i] == ',')\par
\{\par
printf("%c\\t\\tSpecial Symbol\\n", input[i]);\par
i++;\par
\}\par
else\par
\{\par
printf("%c\\t\\tUnknown Symbol\\n", input[i]);\par
i++; \}\par
\}\par
return 0;\par
\}\par

